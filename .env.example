# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RetroGameTalk Scraper Service Configuration (Container / Kubernetes)
PORT=3000
DATA_DIR="/app/data"
DOWNLOAD_DIR="/run/repo"
RGT_BASE_URL="https://retrogametalk.com/repo/"
RGT_LOGIN_URL="https://retrogametalk.com/login/login"
RGT_USERNAME=""
RGT_PASSWORD=""
CRON_SCHEDULE="0 */6 * * *"
SCRAPER_SYSTEM_FILTER=""
