# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RetroGameTalk Scraper Service Configuration (Container / Kubernetes)
PORT=3000
DATA_DIR="/run/repo/.rgt-data"
DOWNLOAD_DIR="/run/repo"
RGT_BASE_URL="https://retrogametalk.com/repo/"
RGT_LOGIN_URL="https://retrogametalk.com/login/login"
RGT_USERNAME=""
RGT_PASSWORD=""
# Optional self-hosted UI/API lock (leave empty for open LAN/local access with zero login friction)
APP_AUTH_USERNAME=""
APP_AUTH_PASSWORD=""
CRON_SCHEDULE="0 */6 * * *"
SCRAPER_SYSTEM_FILTER=""
# Set SCRAPER_DEBUG="true" (or LOG_LEVEL="debug") for verbose scrape/download/archive/SD-install diagnostics
SCRAPER_DEBUG="false"
APP_VERSION="dev"
GIT_SHA="unknown"
# Optional base repository URL (e.g. https://github.com/owner/repo) to link branch and commit SHA in the UI
GIT_URL="https://github.com/jeremyj563/retrogametalk-sync"
